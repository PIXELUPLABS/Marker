      },
      "tertiary": {
        "$type": "color",
        "$value": "#666666",
        "$description": "Captions, meta, labels on light surfaces (AA on page and white)."
      },
      "muted": {
        "$type": "color",
        "$value": "#888888",
        "$description": "De-emphasised half of two-tone headlines, 24px+ only (3.3:1 on page). Replaces #8F8F8F, which measured 2.99:1 and failed even the large-text minimum."
      },
      "inverse": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Primary text on dark and black surfaces."
      },
      "inverse-secondary": {
        "$type": "color",
        "$value": "#B4B4B4",
        "$description": "Secondary text on dark and black surfaces."
      }
    },
    "surface": {
