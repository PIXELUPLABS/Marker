{
  "$description": "Marker design tokens v1.1 (Nov 2026). Source of truth for colour, type, space, radius, shadow, motion and layout. Format: W3C Design Tokens Community Group (DTCG). Reconciled from Figma variables (file AX5DIfecorSfNIi8MjEvtb), Brand Guidelines v1.0 (Aug 2026) and the shipped build. Regenerate tokens.css and tailwind-theme.css with `python tools/build_tokens.py` after editing.",
  "color": {
    "brand": {
      "persimmon": {
        "$type": "color",
        "$value": "#F35901",
        "$description": "Primary accent. Emphasis, data highlights, progress, the quote card. Large text only when used as text colour on white (3.4:1)."
      },
      "lime": {
        "$type": "color",
        "$value": "#DDE830",
        "$description": "Highlighter. Sits behind 1–4 key words per headline, and fills the closing CTA band. Always with ink text."
      },
      "beige": {
        "$type": "color",
        "$value": "#F6CD91",
        "$description": "Supporting accent for illustrations, chips and data series."
      },
      "green": {
        "$type": "color",
        "$value": "#78D990",
        "$description": "Supporting accent. Doubles as the positive/success colour."
      },
      "pink": {
        "$type": "color",
        "$value": "#DBBFE9",
        "$description": "Supporting accent for illustrations and data series. Use sparingly."
      },
      "sky": {
        "$type": "color",
        "$value": "#87D1F8",
        "$description": "Supporting accent for illustration and data only (the 'in progress' state in How-it-works step 3). Never for text, UI or backgrounds."
      }
    },
    "ink": {
      "default": {
        "$type": "color",
        "$value": "#1A1A1A",
        "$description": "Dark ink. Primary text, page shell, logo tile. Replaces the legacy #17201B."
      },
      "secondary": {
        "$type": "color",
        "$value": "#4D4D4D",
