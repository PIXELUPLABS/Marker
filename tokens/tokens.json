      "sunken": {
        "$type": "color",
        "$value": "#E8E8E8",
        "$description": "Footer band and pressed states."
      },
      "dark": {
        "$type": "color",
        "$value": "#2B2B2B",
        "$description": "Primary button fill, dark UI chrome."
